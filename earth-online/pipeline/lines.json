{
  "voice_sid": 62,
  "speed": 1.0,
  "scenes": [
    {"id": "s0_boot",    "lead": 0.0, "tail": 4.0, "lines": []},
    {"id": "s1_school",  "lead": 1.2, "tail": 1.6, "lines": [
      {"id": "L01", "text": "上学那会儿，这个游戏很简单。"},
      {"id": "L02", "text": "系统告诉你打哪个怪，打完就给分。", "say": "系统告诉你打哪个怪，打完，就给分。", "pre": 0.5},
      {"id": "L03", "text": "其他的事，都叫娱乐。", "pre": 0.6}
    ]},
    {"id": "s2_empty",   "lead": 2.2, "tail": 1.8, "lines": [
      {"id": "L04", "text": "毕业那天，任务栏空了。"},
      {"id": "L05", "text": "没有提示，也没有下一关。", "pre": 0.7},
      {"id": "L06", "text": "我在原地站了挺久。", "say": "我在原第站了挺久。", "pre": 1.0}
    ]},
    {"id": "s3_money",   "lead": 1.8, "tail": 1.2, "lines": [
      {"id": "L07", "text": "后来我自己填了一个：挣钱。"},
      {"id": "L08", "text": "挺好，目标清楚，数字会涨。", "say": "挺好，目标清榋，数字会涨。", "pre": 0.5},
      {"id": "L09", "text": "只是有一天我发现，", "pre": 2.4},
      {"id": "L10", "text": "到账的提示音响了，我已经不会抬头了。", "pre": 0.2}
    ]},
    {"id": "s4_others",  "lead": 3.2, "tail": 1.2, "lines": [
      {"id": "L11", "text": "我开始留意别人头顶的任务。"},
      {"id": "L12", "text": "有人的主线是一锅汤，有人是一盆花。", "say": "有人的主线是一锅汤。有人，是一盆花。", "pre": 1.4},
      {"id": "L13", "text": "他们看起来，都挺高兴的。", "pre": 0.8},
      {"id": "L14", "text": "我也想要那样一件事，能让我忘了看时间。", "pre": 1.6},
      {"id": "L15", "text": "说实话，还没找到。", "pre": 0.8},
      {"id": "L16", "text": "偶尔碰到一下，第二天就没了。", "pre": 0.5}
    ]},
    {"id": "s5_team",    "lead": 2.6, "tail": 1.0, "lines": [
      {"id": "L17", "text": "后来，我有了一支AI队伍。"},
      {"id": "L18", "text": "我说一句，它们就去做。", "pre": 0.5},
      {"id": "L19", "text": "能不能做出来，不再是问题。", "pre": 0.6},
      {"id": "L20", "text": "问题变成了：我到底想做什么。", "pre": 0.9}
    ]},
    {"id": "s6_loop",    "lead": 1.6, "tail": 11.0, "lines": [
      {"id": "L21", "text": "所以我给它们派了第一个任务："},
      {"id": "L22", "text": "把我这些零零碎碎的想法，做成一部片子。", "pre": 0.3},
      {"id": "L23", "text": "就是你现在看的这部。", "pre": 0.5},
      {"id": "L24", "text": "做它的那天晚上，到两点多我才发现，忘了看时间。", "pre": 2.2}
    ]}
  ]
}
