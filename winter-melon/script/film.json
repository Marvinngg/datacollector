                "show": "arrive",
                "dur": 2.4
              },
              {
                "say": "xiao",
                "text": "李叔，我来收瓜。",
                "how": "客气、带点小心地说"
              },
              {
                "say": "qin",
                "text": "不卖。",
                "how": "用七十多岁老汉低沉的声音，冷淡、干脆地说，头也不抬"
              },
              {
                "say": "xiao",
                "text": "一块二一斤，比去年还高。",
                "how": "耐心地、好声好气地劝"
              },
              {
                "say": "qin",
                "text": "市价才八毛。",
                "how": "用老汉低沉的声音，硬邦邦地说"
              },
              {
                "say": "qin",
                "text": "多那四毛，是可怜我？",
                "how": "用老汉的声音，有点生气、有点委屈地反问"
              },
              {
                "show": "pause",
                "dur": 1.1
              },
              {
                "say": "qin",
                "text": "我还没老到要人可怜。",
                "how": "用老汉的声音，倔强、压着情绪、一字一顿地说"
              },
              {
                "show": "leave",
                "dur": 2.8
              }
            ]
